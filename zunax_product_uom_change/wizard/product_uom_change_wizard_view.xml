<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_product_uom_change_wizard_form" model="ir.ui.view">
        <field name="name">product.uom.change.wizard.form</field>
        <field name="model">product.uom.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Unit of Measure (with History)">
                <sheet>
                    <div class="alert alert-warning" role="alert" style="margin-bottom: 15px;">
                        <strong>Warning!</strong> This tool changes the Unit of Measure for the selected product and 
                        recalculates/updates all historical transactions (stock moves, stock move lines, quants, PO lines, 
                        SO lines, and invoice lines) to match. Make sure no other users are currently transacting this product.
                    </div>
                    <group>
                        <group string="Product Information">
                            <field name="product_tmpl_id" readonly="context.get('active_model') == 'product.template'"/>
                            <field name="current_uom_id"/>
                            <field name="current_po_uom_id"/>
                        </group>
                        <group string="New Configuration">
                            <field name="new_uom_id"/>
                            <field name="new_po_uom_id"/>
                        </group>
                    </group>
                    <group string="Quantity Adjustments">
                        <field name="conversion_type" widget="radio"/>
                        <field name="factor" invisible="conversion_type != 'factor'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_change_uom" string="Change UoM" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_product_uom_change_wizard" model="ir.actions.act_window">
        <field name="name">Change UoM (with History)</field>
        <field name="res_model">product.uom.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form</field>
    </record>

    <!-- Menu Item (Inventory -> Configuration -> Product UoM Change) -->
    <menuitem id="menu_product_uom_change"
              name="Change Product UoM (with History)"
              parent="stock.menu_stock_config_settings"
              action="action_product_uom_change_wizard"
              groups="stock.group_stock_manager"
              sequence="90"/>
</odoo>
