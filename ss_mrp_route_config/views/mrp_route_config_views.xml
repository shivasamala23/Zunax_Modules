<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_mrp_route_config_form" model="ir.ui.view">
        <field name="name">mrp.route.config.form</field>
        <field name="model">mrp.route.config</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Route Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Packing Line Route"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Manufacturing Locations">
                            <field name="consumption_location_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="dest_location_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Component Source Rules" name="component_rules">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="categ_id" options="{'no_create': True}"/>
                                    <field name="source_location_id" options="{'no_create': True, 'no_open': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_mrp_route_config_tree" model="ir.ui.view">
        <field name="name">mrp.route.config.list</field>
        <field name="model">mrp.route.config</field>
        <field name="arch" type="xml">
            <list string="Manufacturing Route Configurations">
                <field name="name"/>
                <field name="consumption_location_id"/>
                <field name="dest_location_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mrp_route_config" model="ir.actions.act_window">
        <field name="name">MRP Route Configurations</field>
        <field name="res_model">mrp.route.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Manufacturing Route Configuration
            </p>
            <p>
                Configure component consumption, finished goods destination, and component picking source locations.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_mrp_route_config"
        name="MRP Route Configurations"
        action="action_mrp_route_config"
        parent="mrp.menu_mrp_configuration"
        groups="ss_mrp_route_config.group_mrp_route_config_manager"
        sequence="50"/>
</odoo>
