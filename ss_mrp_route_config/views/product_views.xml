<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Category Form View Inheritance -->
    <record id="product_category_form_view_inherit_mrp_route" model="ir.ui.view">
        <field name="name">product.category.form.inherit.mrp.route</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group string="MRP Route Configuration" name="mrp_route_config">
                    <field name="mrp_route_config_id" options="{'no_create': True}" groups="ss_mrp_route_config.group_mrp_route_config_manager"/>
                    <field name="mrp_comp_source_location_id" options="{'no_create': True, 'no_open': True}" groups="ss_mrp_route_config.group_mrp_route_config_manager"/>

                    <field name="mrp_route_config_id" options="{'no_create': True}" groups="!ss_mrp_route_config.group_mrp_route_config_manager" readonly="1"/>
                    <field name="mrp_comp_source_location_id" options="{'no_create': True, 'no_open': True}" groups="!ss_mrp_route_config.group_mrp_route_config_manager" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product Template Form View Inheritance -->
    <record id="view_template_property_form_inherit_mrp_route" model="ir.ui.view">
        <field name="name">product.template.stock.property.form.inherit.mrp.route</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <group string="MRP Route Configuration" name="mrp_route_config">
                    <field name="mrp_route_config_id" options="{'no_create': True}" groups="ss_mrp_route_config.group_mrp_route_config_manager"/>
                    <field name="mrp_comp_source_location_id" options="{'no_create': True, 'no_open': True}" groups="ss_mrp_route_config.group_mrp_route_config_manager"/>

                    <field name="mrp_route_config_id" options="{'no_create': True}" groups="!ss_mrp_route_config.group_mrp_route_config_manager" readonly="1"/>
                    <field name="mrp_comp_source_location_id" options="{'no_create': True, 'no_open': True}" groups="!ss_mrp_route_config.group_mrp_route_config_manager" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
