<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated category so the group appears on the user form -->
    <record id="module_category_mrp_route_config" model="ir.module.category">
        <field name="name">MRP Route Config</field>
        <field name="sequence">100</field>
        <field name="visible">1</field>
    </record>

    <record id="group_mrp_route_config_manager" model="res.groups">
        <field name="name">MRP Route Config Manager</field>
        <field name="category_id" ref="module_category_mrp_route_config"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="mrp_route_config_multi_company_rule" model="ir.rule">
            <field name="name">MRP Route Config Multi-Company</field>
            <field name="model_id" ref="model_mrp_route_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="mrp_route_config_line_multi_company_rule" model="ir.rule">
            <field name="name">MRP Route Config Line Multi-Company</field>
            <field name="model_id" ref="model_mrp_route_config_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
