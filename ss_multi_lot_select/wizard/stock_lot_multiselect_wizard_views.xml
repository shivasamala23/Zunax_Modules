<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Wizard View: Multi Lot/Serial Selector
         ================================================================ -->
    <record id="view_stock_lot_multiselect_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.multiselect.wizard.form</field>
        <field name="model">stock.lot.multiselect.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Multiple Lots / Serial Numbers">
                <sheet>
                    <!-- Product summary banner -->
                    <div class="alert alert-info d-flex align-items-center mb-2" role="alert">
                        <i class="fa fa-info-circle me-2"/>
                        <div>
                            Selecting lots for
                            <strong><field name="product_id" readonly="1" nolabel="1"/></strong>
                            from location
                            <strong><field name="location_id" readonly="1" nolabel="1"/></strong>.
                            <span invisible="has_tracking != 'serial'">
                                Each serial number will get quantity <b>1</b>.
                            </span>
                        </div>
                    </div>

                    <field name="has_tracking" invisible="1"/>

                    <!-- Quantity per lot (only relevant for Lot tracking, not serial) -->
                    <group invisible="has_tracking == 'serial'">
                        <field name="quantity_per_lot" string="Quantity per Lot"/>
                    </group>

                    <!-- Action buttons row -->
                    <div class="d-flex gap-2 mb-2">
                        <button
                            name="action_select_all"
                            type="object"
                            string="Select All"
                            class="btn btn-sm btn-secondary"
                            icon="fa-check-square-o"/>
                        <button
                            name="action_deselect_all"
                            type="object"
                            string="Deselect All"
                            class="btn btn-sm btn-secondary"
                            icon="fa-square-o"/>
                        <button
                            name="action_refresh"
                            type="object"
                            string="Refresh Available Lots"
                            class="btn btn-sm btn-secondary"
                            icon="fa-refresh"/>
                    </div>

                    <!-- Lot lines tree -->
                    <field name="lot_line_ids" nolabel="1">
                        <list editable="bottom"
                              decoration-success="selected"
                              decoration-muted="not selected"
                              create="0"
                              delete="0">
                            <field name="selected" widget="boolean_toggle" string="Select" optional="show"/>
                            <field name="lot_name" string="Lot / Serial Number" readonly="1"/>
                            <field name="available_qty" string="Available Qty" readonly="1"/>
                            <field name="expiration_date" string="Expiry Date" readonly="1" optional="show"/>
                        </list>
                    </field>

                    <!-- No lots available notice -->
                    <div class="alert alert-warning mt-2"
                         invisible="lot_line_ids"
                         role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        No lots/serial numbers found in the source location for this product.
                        Make sure inventory is available and the product is tracked by lot or serial number.
                    </div>
                </sheet>

                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Add Selected Lots"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Action to open the wizard
         ================================================================ -->
    <record id="action_stock_lot_multiselect_wizard" model="ir.actions.act_window">
        <field name="name">Select Multiple Lots/Serials</field>
        <field name="res_model">stock.lot.multiselect.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="context">{'default_move_id': active_id}</field>
    </record>

</odoo>
