<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherit the stock.move "Details" popup form (view_stock_move_operations)
        to add a "Select Multiple Lots/Serials" button next to the existing
        "Generate Serials" / "Import Lots" buttons.
    -->
    <record id="view_stock_move_operations_multi_lot_inherit" model="ir.ui.view">
        <field name="name">stock.move.operations.form.multi_lot</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <!-- Insert button after the import_lots widget in the buttons div -->
            <xpath expr="//widget[@name='import_lots']" position="after">
                <button
                    name="%(ss_multi_lot_select.action_stock_lot_multiselect_wizard)d"
                    type="action"
                    string="Select Multiple Lots/Serials"
                    class="btn btn-link btn-group"
                    icon="fa-list"
                    invisible="has_tracking == 'none'"
                    context="{'default_move_id': id}"
                />
            </xpath>

        </field>
    </record>

</odoo>
