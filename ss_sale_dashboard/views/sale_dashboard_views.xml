<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom client action for the OWL Sales & Collection Dashboard -->
    <record id="action_sale_dashboard" model="ir.actions.client">
        <field name="name">Sales &amp; Collection Dashboard</field>
        <field name="tag">ss_sale_dashboard_tag</field>
        <field name="target">current</field>
    </record>


    <!-- Menu Item under Sales -> Reporting -->
    <menuitem id="menu_sale_dashboard"
              name="Sales Dashboard"
              action="action_sale_dashboard"
              parent="sale.menu_sale_report"
              sequence="1"/>
</odoo>

