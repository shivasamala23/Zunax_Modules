<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_target_tree" model="ir.ui.view">
        <field name="name">sale.target.list</field>
        <field name="model">sale.target</field>
        <field name="arch" type="xml">
            <list string="Sales Targets" editable="top">
                <field name="year" readonly="1"/>
                <field name="month" readonly="1"/>
                <field name="target_amount" sum="Total Target"/>
                <field name="company_id" groups="base.group_multi_company" domain="[]" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_sale_target_search" model="ir.ui.view">
        <field name="name">sale.target.search</field>
        <field name="model">sale.target</field>
        <field name="arch" type="xml">
            <search string="Search Sales Targets">
                <field name="year"/>
                <field name="month"/>
                <field name="company_id" groups="base.group_multi_company" domain="[]"/>
                <group expand="0" string="Group By">
                    <filter string="Year" name="group_by_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="group_by_month" context="{'group_by': 'month'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_target" model="ir.actions.act_window">
        <field name="name">Sales Targets</field>
        <field name="res_model">sale.target</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_sale_target_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your Monthly Sales Targets here.
            </p>
            <p>
                The Sales Dashboard will compare these targets with actual Sales Order completions.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_target"
              name="Sales Targets"
              action="action_sale_target"
              parent="sale.menu_sale_config"
              sequence="20"/>
</odoo>
