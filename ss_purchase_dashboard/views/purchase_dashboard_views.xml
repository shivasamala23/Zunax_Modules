<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom client action for the OWL Purchase Dashboard -->
    <record id="action_purchase_dashboard" model="ir.actions.client">
        <field name="name">Purchase Dashboard</field>
        <field name="tag">ss_purchase_dashboard_tag</field>
        <field name="target">current</field>
    </record>

    <!-- Custom tree view for Purchase Order Line drill-down -->
    <record id="view_purchase_order_line_tree_dashboard" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.dashboard</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Order Lines" create="false" edit="false" delete="false">
                <field name="order_id" string="PO Number"/>
                <field name="invoice_lines" widget="many2many_tags" string="Bill Numbers"/>
                <field name="partner_id" string="Vendor"/>
                <field name="product_id" string="Product"/>
                <field name="product_qty" string="Quantity"/>
                <field name="price_unit" string="Unit Price" widget="monetary"/>
                <field name="price_subtotal" string="Subtotal" widget="monetary"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Custom tree view for Move Line drill-down -->
    <record id="view_account_move_line_tree_dashboard" model="ir.ui.view">
        <field name="name">account.move.line.tree.dashboard</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Vendor Bill Lines" create="false" edit="false" delete="false">
                <field name="date" string="Date"/>
                <field name="move_id" string="Bill Reference"/>
                <field name="ref" string="Bill Number"/>
                <field name="purchase_order_id" string="PO Number"/>
                <field name="partner_id" string="Vendor"/>
                <field name="product_id" string="Product"/>
                <field name="quantity" string="Quantity"/>
                <field name="price_unit" string="Unit Price" widget="monetary"/>
                <field name="price_subtotal" string="Subtotal" widget="monetary"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Savings Report Views -->
    <record id="view_purchase_savings_report_tree" model="ir.ui.view">
        <field name="name">purchase.savings.report.tree</field>
        <field name="model">purchase.savings.report</field>
        <field name="arch" type="xml">
            <list string="Cost Savings Report" create="false" edit="false" delete="false">
                <field name="invoice_date" string="Order Date"/>
                <field name="move_id" string="Latest PO"/>
                <field name="latest_bill_id" string="Latest Bill"/>
                <field name="latest_bill_ref" string="Latest Bill No"/>
                <field name="prev_po_id" string="Previous PO"/>
                <field name="prev_bill_id" string="Previous Bill"/>
                <field name="prev_bill_ref" string="Previous Bill No"/>
                <field name="partner_id" string="Vendor"/>
                <field name="product_id" string="Product"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="baseline_price" widget="monetary" string="Previous PO Unit Price"/>
                <field name="current_price" widget="monetary" string="Latest PO Unit Price"/>
                <field name="saving_amount" widget="monetary" string="Savings" sum="Total Savings"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_savings_report_search" model="ir.ui.view">
        <field name="name">purchase.savings.report.search</field>
        <field name="model">purchase.savings.report</field>
        <field name="arch" type="xml">
            <search string="Search Cost Savings">
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="move_id" string="Latest PO"/>
                <field name="latest_bill_id" string="Latest Bill"/>
                <field name="prev_po_id" string="Previous PO"/>
                <field name="prev_bill_id" string="Previous Bill"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                    <filter string="Vendor" name="group_by_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Latest PO" name="group_by_move" context="{'group_by':'move_id'}"/>
                    <filter string="Latest Bill" name="group_by_latest_bill" context="{'group_by':'latest_bill_id'}"/>
                    <filter string="Previous PO" name="group_by_prev_po" context="{'group_by':'prev_po_id'}"/>
                    <filter string="Previous Bill" name="group_by_prev_bill" context="{'group_by':'prev_bill_id'}"/>
                    <filter string="Order Date" name="group_by_date" context="{'group_by':'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_savings_report" model="ir.actions.act_window">
        <field name="name">Cost Savings Details</field>
        <field name="res_model">purchase.savings.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_purchase_savings_report_search"/>
    </record>

    <!-- Menu Item under Purchase -> Reporting -->
    <menuitem id="menu_purchase_dashboard"
              name="Purchase Dashboard"
              action="action_purchase_dashboard"
              parent="purchase.purchase_report_main"
              sequence="3"/>
</odoo>
