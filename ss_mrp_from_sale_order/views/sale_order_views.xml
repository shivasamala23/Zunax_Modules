<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_mrp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.mrp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_custom_mrp_production"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    invisible="custom_mrp_production_count == 0">
                    <field name="custom_mrp_production_count" widget="statinfo" string="Custom MOs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
