<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add IT Tickets menu to the Portal Home sidebar layout -->
    <template id="portal_layout_it_tickets" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'it_ticket'" t-attf-class="breadcrumb-item #{'active' if not ticket else ''}">
                <a t-if="ticket" href="/my/tickets">IT Support Tickets</a>
                <t t-else="">IT Support Tickets</t>
            </li>
            <li t-if="ticket" class="breadcrumb-item active">
                <span t-field="ticket.ticket_number"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_it_tickets" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <style>
                .o_portal_icon img[src*="zunax_it_ticketing"] {
                    max-width: 48px !important;
                    max-height: 48px !important;
                    height: auto !important;
                    object-fit: contain;
                }
            </style>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">IT Support Tickets</t>
                <t t-set="text">Raise and manage your IT support tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="placeholder_count" t-value="'it_ticket_count'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="icon" t-value="'/zunax_it_ticketing/static/description/icon.png'"/>
            </t>
        </xpath>
    </template>

    <!-- Portal List View for Tickets -->
    <template id="portal_my_tickets" name="My IT Support Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">IT Support Tickets</t>
            </t>

            <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
                <h3 class="mb-0">IT Support Tickets</h3>
                <a href="/raise-ticket" class="btn btn-primary"><i class="fa fa-plus-circle"/> Raise New Ticket</a>
            </div>

            <t t-if="not tickets">
                <div class="alert alert-info shadow-sm" role="alert">
                    There are currently no IT support tickets for your account. You can raise one by clicking the **Raise New Ticket** button above or via our <a href="/raise-ticket">IT Support Form</a>.
                </div>
            </t>

            <t t-if="tickets" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Ticket ID</th>
                        <th>Subject</th>
                        <th>IT Department</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="tickets" t-as="ticket">
                        <tr>
                            <td>
                                <a t-attf-href="/my/ticket/#{ticket.id}"><span t-field="ticket.ticket_number"/></a>
                            </td>
                            <td>
                                <span t-field="ticket.name"/>
                            </td>
                            <td>
                                <span t-field="ticket.department_id.name"/>
                            </td>
                            <td>
                                <span t-if="ticket.stage == 'new'" class="badge bg-primary">New</span>
                                <span t-elif="ticket.stage == 'in_progress'" class="badge bg-warning text-dark">In Progress</span>
                                <span t-elif="ticket.stage == 'resolved'" class="badge bg-success">Resolved</span>
                                <span t-elif="ticket.stage == 'cancelled'" class="badge bg-secondary">Cancelled</span>
                            </td>
                            <td>
                                <span t-field="ticket.create_date" t-options="{'widget': 'date'}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Portal Detailed View with Chatter -->
    <template id="portal_my_ticket_detail" name="My IT Ticket Detail">
        <t t-call="portal.portal_layout">
            <div id="optional_placeholder"/>
            <div class="container bg-white pb-5 shadow-sm rounded">
                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Ticket Details - <span t-field="ticket.ticket_number"/></h4>
                        <div>
                            <span t-if="ticket.stage == 'new'" class="badge bg-primary fs-6">New</span>
                            <span t-elif="ticket.stage == 'in_progress'" class="badge bg-warning text-dark fs-6">In Progress</span>
                            <span t-elif="ticket.stage == 'resolved'" class="badge bg-success fs-6">Resolved</span>
                            <span t-elif="ticket.stage == 'cancelled'" class="badge bg-secondary fs-6">Cancelled</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5>Subject:</h5>
                                <p class="lead" t-field="ticket.name"/>
                            </div>
                            <div class="col-md-6">
                                <h5>IT Department:</h5>
                                <p class="lead" t-field="ticket.department_id.name"/>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <h5>Description:</h5>
                                <div class="border rounded p-3 bg-light">
                                    <span t-out="ticket.description or 'No description provided.'"/>
                                </div>
                            </div>
                        </div>

                        <t t-if="ticket.stage == 'resolved'">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="alert alert-success">
                                        <h5 class="alert-heading"><i class="fa fa-check-circle"/> Resolution Notes</h5>
                                        <hr/>
                                        <span t-out="ticket.resolution_notes or 'This issue has been marked resolved.'"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Contact Name:</strong> <span t-field="ticket.partner_id.name"/><br/>
                                <strong>Email:</strong> <span t-field="ticket.email"/>
                            </div>
                            <div class="col-md-6">
                                <strong>Assigned Representative:</strong> <span t-out="ticket.assigned_user_id.name or 'Pending Assignment'"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chatter integration for direct messaging -->
                <div class="mt-5">
                    <h4>Discussion &amp; Support History</h4>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="ticket"/>
                        <t t-set="token" t-value="False"/>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Public / Intranet Submission Form (Highly Premium Visual Styling) -->
    <template id="raise_ticket_public_form" name="Raise IT Support Ticket">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Embedded Premium CSS Styles -->
                <style>
                    .it-support-container {
                        max-width: 700px;
                        margin: 50px auto;
                        padding: 40px;
                        background: rgba(255, 255, 255, 0.9);
                        border-radius: 16px;
                        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
                        backdrop-filter: blur(10px);
                        border: 1px solid rgba(255, 255, 255, 0.3);
                        font-family: 'Inter', sans-serif;
                    }
                    .it-support-bg {
                        background: radial-gradient(circle at 10% 20%, rgb(240, 243, 248) 0%, rgb(222, 230, 240) 90.1%);
                        min-height: 100vh;
                        padding: 20px 0;
                    }
                    .it-header {
                        text-align: center;
                        margin-bottom: 40px;
                    }
                    .it-header h1 {
                        font-weight: 700;
                        color: #1a2530;
                        background: linear-gradient(45deg, #714B67, #a24b89);
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        margin-bottom: 10px;
                    }
                    .it-header p {
                        color: #667582;
                        font-size: 1.1rem;
                    }
                    .form-label {
                        font-weight: 600;
                        color: #344054;
                        margin-bottom: 8px;
                    }
                    .form-control, .form-select {
                        border: 1px solid #d0d5dd;
                        border-radius: 8px;
                        padding: 12px 16px;
                        transition: all 0.2s ease-in-out;
                    }
                    .form-control:focus, .form-select:focus {
                        border-color: #714B67;
                        box-shadow: 0 0 0 4px rgba(113, 75, 103, 0.15);
                    }
                    .btn-premium {
                        background: linear-gradient(135deg, #714B67 0%, #52354a 100%);
                        color: white;
                        font-weight: 600;
                        border: none;
                        padding: 14px 30px;
                        border-radius: 8px;
                        transition: all 0.3s ease;
                        box-shadow: 0 4px 12px rgba(113, 75, 103, 0.2);
                        width: 100%;
                    }
                    .btn-premium:hover {
                        background: linear-gradient(135deg, #87597b 0%, #714B67 100%);
                        box-shadow: 0 6px 18px rgba(113, 75, 103, 0.3);
                        transform: translateY(-2px);
                        color: white;
                    }
                    .required-star {
                        color: #d92d20;
                        margin-left: 3px;
                    }
                    .error-banner {
                        border-left: 4px solid #d92d20;
                        background-color: #fef3f2;
                        color: #b54708;
                        padding: 16px;
                        border-radius: 8px;
                        margin-bottom: 24px;
                        font-size: 0.95rem;
                    }
                </style>

                <div class="it-support-bg">
                    <div class="container">
                        <div class="it-support-container">
                            <div class="it-header">
                                <img src="/zunax_it_ticketing/static/description/icon.png" alt="IT Support Logo" style="max-height: 80px; margin-bottom: 15px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);"/>
                                <h1>IT Support Portal</h1>
                                <p>Submit a ticket and our IT department will resolve it promptly.</p>
                            </div>

                            <!-- Error Message Banner -->
                            <t t-if="error">
                                <div class="error-banner">
                                    <i class="fa fa-exclamation-circle me-2"/> <t t-esc="error"/>
                                </div>
                            </t>

                            <form action="/raise-ticket/submit" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="name" class="form-label">Full Name</label>
                                        <input type="text" class="form-control" id="name" name="name" 
                                               t-att-value="default_name or (post.get('name') if post else '')"
                                               placeholder="Your Name"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="email" class="form-label">Work Email<span class="required-star">*</span></label>
                                        <input type="email" class="form-control" id="email" name="email" required="required"
                                               t-att-value="default_email or (post.get('email') if post else '')"
                                               placeholder="username@company.com"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="phone" class="form-label">Mobile Number</label>
                                        <input type="text" class="form-control" id="phone" name="phone"
                                               t-att-value="post.get('phone') if post else ''"
                                               placeholder="WhatsApp enabled mobile phone"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="department" class="form-label">Target IT Department<span class="required-star">*</span></label>
                                        <select class="form-select" id="department" name="department_id" required="required">
                                            <option value="" disabled="disabled" selected="selected">-- Select IT Team --</option>
                                            <t t-foreach="departments" t-as="dept">
                                                <option t-att-value="dept.id" 
                                                        t-att-selected="post.get('department_id') == str(dept.id) if post else False">
                                                    <t t-esc="dept.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="subject" class="form-label">Issue Subject / Topic<span class="required-star">*</span></label>
                                    <input type="text" class="form-control" id="subject" name="subject" required="required"
                                           t-att-value="post.get('subject') if post else ''"
                                           placeholder="e.g. Printer Offline, Password Reset, Cannot Access ERP"/>
                                </div>

                                <div class="mb-4">
                                    <label for="description" class="form-label">Detailed Description</label>
                                    <textarea class="form-control" id="description" name="description" rows="5"
                                              placeholder="Provide any details, error codes, screenshots description, or hardware model details..."><t t-esc="post.get('description') if post else ''"/></textarea>
                                </div>

                                <button type="submit" class="btn btn-premium mt-2">
                                    <i class="fa fa-paper-plane me-2"/> Submit Support Ticket
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Success Screen (Premium Presentation) -->
    <template id="raise_ticket_thankyou" name="Support Ticket Submitted">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <style>
                    .thankyou-card {
                        max-width: 600px;
                        margin: 100px auto;
                        padding: 50px 40px;
                        background: white;
                        border-radius: 16px;
                        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
                        text-align: center;
                        font-family: 'Inter', sans-serif;
                    }
                    .success-icon {
                        font-size: 4rem;
                        color: #12b76a;
                        margin-bottom: 24px;
                        animation: scaleIn 0.5s ease-out;
                    }
                    .ticket-num-badge {
                        background-color: #f4ebf4;
                        color: #714B67;
                        font-weight: 700;
                        font-size: 1.25rem;
                        padding: 10px 24px;
                        border-radius: 30px;
                        display: inline-block;
                        margin: 20px 0;
                        letter-spacing: 0.5px;
                    }
                    @keyframes scaleIn {
                        0% { transform: scale(0.7); opacity: 0; }
                        100% { transform: scale(1); opacity: 1; }
                    }
                    .btn-home {
                        background-color: #714B67;
                        color: white;
                        font-weight: 600;
                        padding: 12px 28px;
                        border-radius: 8px;
                        transition: all 0.2s;
                        border: none;
                        display: inline-block;
                        text-decoration: none;
                        margin-top: 15px;
                    }
                    .btn-home:hover {
                        background-color: #5d3d54;
                        color: white;
                        box-shadow: 0 4px 12px rgba(113, 75, 103, 0.25);
                    }
                </style>
                <div class="container">
                    <div class="thankyou-card">
                        <div class="success-icon">
                            <i class="fa fa-check-circle"/>
                        </div>
                        <h2 class="fw-bold mb-3">Ticket Submitted Successfully!</h2>
                        <p class="text-muted fs-5">Thank you for reporting this issue. A support ticket has been created and assigned to our IT department specialists.</p>
                        
                        <div>
                            <span class="ticket-num-badge"><t t-esc="ticket_number"/></span>
                        </div>
                        <p class="fw-bold text-dark"><t t-esc="subject"/></p>
                        
                        <p class="text-muted small mb-4">You will receive an automatic email and a WhatsApp notification when the ticket is updated or resolved.</p>
                        
                        <a href="/raise-ticket" class="btn-home">Raise Another Ticket</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
