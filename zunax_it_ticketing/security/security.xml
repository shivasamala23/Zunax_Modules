<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- IT Ticketing Category -->
        <record id="module_category_it_ticketing" model="ir.module.category">
            <field name="name">IT Support Ticketing</field>
            <field name="description">Manage IT department support tickets and routing</field>
            <field name="sequence">20</field>
        </record>

        <!-- 1. User Group (End User / Employee) -->
        <record id="group_it_ticket_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_it_ticketing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Regular employees who can raise support tickets and view/cancel their own tickets.</field>
        </record>

        <!-- 2. Support Staff Group -->
        <record id="group_it_support_staff" model="res.groups">
            <field name="name">Support Staff</field>
            <field name="category_id" ref="module_category_it_ticketing"/>
            <field name="implied_ids" eval="[(4, ref('group_it_ticket_user'))]"/>
            <field name="comment">IT Support desk staff who assign and resolve tickets.</field>
        </record>

        <!-- 3. Manager Group -->
        <record id="group_it_support_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_it_ticketing"/>
            <field name="implied_ids" eval="[(4, ref('group_it_support_staff'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">IT department managers with full configuration and management privileges.</field>
        </record>

        <!-- Record Rules: Portal Users (Own Tickets only) -->
        <record id="it_ticket_portal_rule" model="ir.rule">
            <field name="name">Portal Users: Own Tickets Only</field>
            <field name="model_id" ref="model_it_ticket"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rules: Standard Users (Own Tickets only) -->
        <record id="it_ticket_user_rule" model="ir.rule">
            <field name="name">End Users: Own Tickets Only</field>
            <field name="model_id" ref="model_it_ticket"/>
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_it_ticket_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rules: Support Staff & Managers (All Tickets) -->
        <record id="it_ticket_staff_rule" model="ir.rule">
            <field name="name">Support Staff: All Tickets</field>
            <field name="model_id" ref="model_it_ticket"/>
            <field name="domain_force">[('stage', '!=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('group_it_support_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
